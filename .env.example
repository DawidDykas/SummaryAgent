# =============================================================
#  SummaryAgent - konfiguracja (.env)
#  Skopiuj plik:  cp .env.example .env
# =============================================================

# ---- Zewnętrzne API (zgodne z OpenAI) ------------------------
# PUSTE pole  =>  automatycznie używamy lokalnej Ollamy.
# Wpisz adres =>  używamy Twojego API (OpenAI, Groq, OpenRouter, DeepSeek...).
# Np. https://api.openai.com/v1   lub   https://api.groq.com/openai/v1
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Ollama (fallback, gdy LLM_API_URL jest puste) ------------
# W docker-compose domyślnie nadpisywane na http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Przetwarzanie (opcjonalne) -------------------------------
# Wielkość części, na które dzielone są za duże pliki (znaki)
CHUNK_SIZE=12000
CHUNK_OVERLAP=400
# Ile części dokumentu analizować RÓWNOLEGLE (1-8)
SUMMARY_CONCURRENCY=2
# Limity uploadu
MAX_FILE_SIZE_MB=25
MAX_FILES=10
# Jak długo dokumenty trzymamy w pamięci (sekundy)
DOC_TTL_SECONDS=3600

# ---- Logowanie (opcjonalne) -----------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true = JSON (produkcja), false = czytelna konsola (dev)
LOG_JSON=false
